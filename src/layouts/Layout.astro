---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'balagan3sh_g@greets-you' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Terminal-based portfolio for Balaganesh G — SRE & DevOps Engineer" />
    <meta name="author" content="Balaganesh G" />
    <meta property="og:title" content="balagan3sh_g@sre-portfolio:~$" />
    <meta property="og:description" content="SRE & DevOps Engineer — type 'help' to explore" />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#0d1117" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
